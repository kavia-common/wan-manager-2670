%config {
    name = "wan-manager";
    import-dbg = false;
    prefix_ = "X_PRPL-COM_";
}

include "../../odl/${name}_definition.odl";
include "../../odl/${name}_WAN_definition.odl";
include "../../odl/${name}_WAN_Intf_definition.odl";

%define{
    object Device;
    object DHCPv4 {
        object Client[] {
            %unique %key string Alias;
            bool Enable;
            string Interface;
        }
    }

    object DHCPv6 {
        object Client[] {
            %unique %key string Alias;
            bool Enable;
            string Interface;
        }
    }

    object DSLite {
        bool Enable;
        object InterfaceSetting[] {
            %unique %key string Alias;
            bool Enable;
            string WANInterface;
        }
    }

    object PCP {
        string '${prefix_}Enable';
    }

    object IP{
        object Interface {}
    }

    object DNS{
        object Relay {
            object Forwarding{}
        }
    }

    object NetDev{
        object Link {}
    }

    object Logical {
        object Interface {}
    }

    object Routing{
        object RouteInformation{
        }
    }

    object '${prefix_}WANAutoSensing'{}
}

%populate {
    object '${prefix_}WANManager' {
        parameter WANMode = "demo_wanmode";
    }

    object '${prefix_}WANManager.WAN' {
        instance add ("demo_wanmode"){
           parameter PhysicalType = "Ethernet";
        }
        instance add ("demo_vlanmode"){
           parameter PhysicalType = "Ethernet";
           parameter DNSMode = "Static";
        }
        instance add ("test_mode"){
           parameter PhysicalType = "Ethernet";
        }

        instance add ("demo_pppmode"){
           parameter Alias = "demo_pppmode";
           parameter PhysicalType = "Ethernet";
        }

        instance add ("demo_staticmode"){
            parameter Alias = "demo_staticmode";
            parameter PhysicalType = "Ethernet";
            parameter EnableSensing = false;
        }

        instance add("demo_dslite"){
            parameter Alias = "demo_dslite";
            parameter PhysicalType = "Ethernet";
        }
     }

    object '${prefix_}WANManager.WAN.demo_wanmode.Intf'{
        instance add(0,"wan"){
            parameter Name = "wan";
            parameter Type = "untagged";
            parameter IPv4Mode = "dhcp4";
            parameter IPv6Mode = "dhcp6";
            parameter IPv4Reference = "Device.IP.Interface.2.";
            parameter IPv6Reference = "Device.IP.Interface.2.";
        }
    }

    object '${prefix_}WANManager.WAN.demo_vlanmode.Intf'{
        instance add(0,"wan"){
            parameter Name = "wan";
            parameter Type = "vlan";
            parameter IPv4Mode = "dhcp4";
            parameter IPv6Mode = "none";
            parameter VlanID = 201;
            parameter VlanPriority = 0;
            parameter IPv4Reference = "Device.IP.Interface.2.";
            parameter IPv6Reference = "Device.IP.Interface.2.";
        }
    }

    object '${prefix_}WANManager.WAN.demo_pppmode.Intf'{
        instance add(0,"wan"){
            parameter Type = "untagged";
            parameter IPv4Mode = "ppp4";
            parameter IPv6Mode = "dhcp6";
            parameter IPv4Reference = "Device.IP.Interface.2.";
            parameter IPv6Reference = "Device.IP.Interface.6.";
        }
    }

    object '${prefix_}WANManager.WAN.demo_dslite.Intf'{
        instance add(0,"wan"){
            parameter Type = "untagged";
            parameter IPv4Mode = "dslite";
            parameter IPv6Mode = "dhcp6";
            parameter IPv4Reference = "Device.IP.Interface.7.";
            parameter IPv6Reference = "Device.IP.Interface.2.";
        }
    }

    object '${prefix_}WANManager.WAN.demo_staticmode.Intf'{
        instance add(0,"wan"){
            parameter Type = "untagged";
            parameter IPv4Mode = "static";
            parameter IPv6Mode = "static";
            parameter IPv4Reference = "Device.IP.Interface.2.";
            parameter IPv6Reference = "Device.IP.Interface.2.";
        }
    }

    object '${prefix_}WANManager.WAN' {
        instance add ("demo_SFP"){
           parameter Alias = "demo_SFP";
           parameter PhysicalType = "SFP";
           object Intf {
                instance add (0,"testwan"){
                    parameter Name = "wan";
                    parameter Type = "untagged";
                    parameter IPv4Mode = "dhcp4";
                    parameter IPv6Mode= "dhcp6";
                    parameter IPv4Reference = "Device.IP.Interface.2.";
                    parameter IPv6Reference = "Device.IP.Interface.2.";
                }
            }
        }
    }

    object '${prefix_}WANManager.WAN' {
        instance add ("demo_test"){
           parameter Alias = "demo_test";
           parameter PhysicalType = "Ethernet";
           object Intf {
                instance add (0,"testwan"){
                    parameter Name = "wan";
                    parameter Type = "untagged";
                    parameter IPv4Mode = "dhcp4";
                    parameter IPv6Mode= "dhcp6";
                    parameter IPv4Reference = "Device.IP.Interface.2.";
                    parameter IPv6Reference = "Device.IP.Interface.2.";
                }
            }
        }
    }

    object '${prefix_}WANManager.WAN.test_mode.Intf'{
        instance add(0,"wan"){
            parameter Name = "wan";
            parameter Type = "untagged";
            parameter IPv4Mode = "dhcp4";
            parameter IPv6Mode = "none";
            parameter IPv4Reference = "Device.IP.Interface.2.";
            parameter IPv6Reference = "Device.IP.Interface.2.";
        }
    }

    object 'DHCPv4.Client' {
        instance add (1, "wan") {
            parameter Interface = "Device.IP.Interface.2.";
        }
    }

    object 'DHCPv6.Client' {
        instance add (1, "wan") {
            parameter Interface = "Device.IP.Interface.2.";
        }
    }

    object 'DSLite.InterfaceSetting' {
        instance add(1, "dslite") {
            parameter WANInterface = "Device.IP.Interface.2.";
        }
    }

    object '${prefix_}WANManager.WAN.demo_vlanmode.Intf.wan.IPv4Address'{
        instance add("ipv4"){
            parameter DNSServers = "8.8.8.8,1.1.1.1";
        }
    }

    object '${prefix_}WANManager.WAN.demo_vlanmode.Intf.wan.IPv6Address'{
        instance add("ipv6"){
            parameter DNSServers = "2620:119:35::35";
        }
    }

    object '${prefix_}WANManager.WAN.demo_staticmode.Intf.wan.IPv6Address'{
        instance add("ipv6"){
            parameter DefaultRouter = "fe80::5014:93ff:fe4d:7cf";
            parameter IPv6Address = "2a02:1802:94:3200:10:18ff:fe01:cc01";
        }
    }

    object '${prefix_}WANManager.WAN.demo_staticmode.Intf.wan.IPv4Address'{
        instance add("ipv4"){
            parameter DefaultRouter = "172.16.110.10";
            parameter IPv4Address = "172.16.110.45";
            parameter SubnetMask = "255.255.255.0";
        }
    }
}
