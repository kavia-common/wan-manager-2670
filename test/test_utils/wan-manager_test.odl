%config {
    name = "wan-manager";
    import-dbg = false;
    prefix_ = "X_PRPL-COM_";
}

include "../../odl/${name}_definition.odl";
include "../../odl/${name}_WAN_definition.odl";
include "../../odl/${name}_WAN_Intf_definition.odl";

%define{
    object Device;
    object DHCPv4 {
        object Client[] {
            %unique %key string Alias;
            bool Enable;
            string Interface;
        }
    }

    object IP{
        object Interface {}
    }

    object DNS{
        object Relay {
            object Forwarding{}
        }
    }

    object NetDev{
        object Link {}
    }

    object Routing{
        object RouteInformation{
            object InterfaceSetting{}
        }
    }

    object '${prefix_}WANAutoSensing'{}
}

%populate {
    object '${prefix_}WANManager' {
        parameter WANMode = "demo_wanmode";
    }

    object '${prefix_}WANManager.WAN' {
        instance add ("demo_wanmode"){
           parameter PhysicalType = "Ethernet";
        }
        instance add ("demo_vlanmode"){
           parameter PhysicalType = "Ethernet";
           parameter DNSMode = "Static";
        }
        instance add ("test_mode"){
           parameter PhysicalType = "Ethernet";
        }

        instance add ("demo_pppmode"){
           parameter Alias = "demo_pppmode";
           parameter PhysicalType = "Ethernet";
        }
     }

    object '${prefix_}WANManager.WAN.demo_wanmode.Intf'{
        instance add(0,"wan"){
            parameter Name = "wan";
            parameter Type = "untagged";
            parameter IPv4Mode = "dhcp4";
            parameter IPv6Mode = "dhcp6";
            parameter IPv4Reference = "Device.IP.Interface.2.";
            parameter IPv6Reference = "Device.IP.Interface.2.";
        }
    }

    object '${prefix_}WANManager.WAN.demo_vlanmode.Intf'{
        instance add(0,"wan"){
            parameter Name = "wan";
            parameter Type = "vlan";
            parameter IPv4Mode = "dhcp4";
            parameter IPv6Mode = "none";
            parameter VlanID = 201;
            parameter VlanPriority = 0;
            parameter IPv4Reference = "Device.IP.Interface.2.";
        }
    }

    object '${prefix_}WANManager.WAN.demo_pppmode.Intf'{
        instance add(0,"wan"){
            parameter Type = "untagged";
            parameter IPv4Mode = "ppp4";
            parameter IPv6Mode = "dhcp6";
            parameter IPv4Reference = "Device.IP.Interface.2.";
            parameter IPv6Reference = "Device.IP.Interface.6.";
        }
    }

    object '${prefix_}WANManager.WAN' {
        instance add ("demo_SFP"){
           parameter Alias = "demo_SFP";
           parameter PhysicalType = "SFP";
           object Intf {
                instance add (0,"testwan"){
                    parameter Name = "wan";
                    parameter Type = "untagged";
                    parameter IPv4Mode = "dhcp4";
                    parameter IPv6Mode= "dhcp6";
                    parameter IPv4Reference = "Device.IP.Interface.2.";
                    parameter IPv6Reference = "Device.IP.Interface.2.";
                }
            }
        }
    }

    object '${prefix_}WANManager.WAN' {
        instance add ("demo_test"){
           parameter Alias = "demo_test";
           parameter PhysicalType = "Ethernet";
           object Intf {
                instance add (0,"testwan"){
                    parameter Name = "wan";
                    parameter Type = "untagged";
                    parameter IPv4Mode = "dhcp4";
                    parameter IPv6Mode= "dhcp6";
                    parameter IPv4Reference = "Device.IP.Interface.2.";
                    parameter IPv6Reference = "Device.IP.Interface.2.";
                }
            }
        }
    }

    object '${prefix_}WANManager.WAN.test_mode.Intf'{
        instance add(0,"wan"){
            parameter Name = "wan";
            parameter Type = "untagged";
            parameter IPv4Mode = "dhcp4";
            parameter IPv6Mode = "none";
            parameter IPv4Reference = "Device.IP.Interface.2.";
            parameter IPv6Reference = "Device.IP.Interface.2.";
        }
    }

    object 'DHCPv4.Client' {
        instance add (1, "wan") {
            parameter Interface = "Device.IP.Interface.2.";
        }
    }

    object '${prefix_}WANManager.WAN.demo_vlanmode.Intf.wan.IPv4Address'{
        instance add("ipv4"){
            parameter DNSServers = "8.8.8.8,1.1.1.1";
        }
    }

    object '${prefix_}WANManager.WAN.demo_vlanmode.Intf.wan.IPv6Address'{
        instance add("ipv6"){
            parameter DNSServers = "2620:119:35::35";
        }
    }
}
