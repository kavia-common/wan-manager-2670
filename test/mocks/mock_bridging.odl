%define {
    object Bridging {
        object Bridge[] {
            void AddPort(%mandatory string LowerLayers, string Alias, bool Enable, uint32 VlanId, string VlanName, uint32 VlanPriority);
            void DisablePort(%mandatory string LowerLayers, uint32 VlanId);
            object Port[] {
                bool ManagementPort = false;
            }
        }

        object LastAddParameters[] {
            string LowerLayers;
            string Alias;
            bool Enable;
            uint32 VlanId;
            string VlanName;
            uint32 VlanPriority;
        }

        object LastDisableParameters[] {
            string LowerLayers;
            uint32 VlanId;
        }
    }
}

%populate {
    object Bridging {
        object Bridge {
            instance add("lan") {
                object 'Port' {
                    instance add(1) {
                        parameter 'ManagementPort' = true;
                    }
                    instance add(2) {
                        parameter 'ManagementPort' = false;
                    }
                }
            }
        }
        object LastAddParameters {
            instance add("Test") {
                parameter LowerLayers = "INITIAL_VALUE";
                parameter Alias = "INITIAL_VALUE";
                parameter Enable = false;
                parameter VlanId = 999;
                parameter VlanName = "INITIAL_VALUE";
                parameter VlanPriority = 999;
            }
        }
        object LastDisableParameters {
            instance add("Test") {
                parameter LowerLayers = "INITIAL_VALUE";
                parameter VlanId = 999;
            }
        }
    }
}
