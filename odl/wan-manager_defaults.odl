%populate {

object '${prefix_}WANManager.WAN' {
        instance add ("demo_wanmode"){
           parameter Alias = "demo_wanmode";
           parameter PhysicalType = "Ethernet";
        }

        instance add ("demo_vlanmode"){
           parameter Alias = "demo_vlanmode";
           parameter PhysicalType = "Ethernet";
        }
     }

object '${prefix_}WANManager.WAN.demo_wanmode.Intf'{
        instance add(0,"wan"){
            parameter Type = "untagged";
            parameter IPv4Mode = "dhcp4";
            parameter IPReference = "IP.Interface.2.";

        }
    }

object '${prefix_}WANManager.WAN.demo_vlanmode.Intf'{
        instance add(0,"vlan"){
            parameter Type = "vlan";
            parameter IPv4Mode = "dhcp4";
            parameter VlanID = 201;
            parameter VlanPriority = 0;
            parameter IPReference = "IP.Interface.2.";
        }
    }
object '${prefix_}WANManager' {
        parameter WANMode = "demo_wanmode";
    }
}
