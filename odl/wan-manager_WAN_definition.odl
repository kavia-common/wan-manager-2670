%define {
    select 'WANManager' {
        /**
         * WAN mode definition
         * @version 1.0
         */
        %persistent object WAN[] {
            on action destroy call wan_destroy;

            /**
            * A non-volatile unique key used to reference this instance (as defined in TR181)
            * @version 1.0
            */
            %persistent %unique %key string Alias {
                on action validate call check_maximum_length 64;
            }

            /**
            * This parameter was deprecated and replaced by the PhysicalReference parameter.
            * When PhysicalReference is filled in the PhysicalType is ignored.
            *
            * Physical interface type of the WAN mode.
            * @version 1.0
            */
            %persistent string PhysicalType {
                on action validate call check_enum ["Ethernet", "ADSL", "VDSL", "SFP", "GPON", "GFAST", "Bridge", "WWAN", ""];
                default "Ethernet";
            }

            /**
            * Reference to an entry of a physical interface.
            * Examples:
            *   - Device.Ethernet.Interface.i.
            *   - Device.Cellular.Interface.i.
            *   - Device.XPON.
            *   - Device.Wifi.SSID.i.
            *
            * @version 1.0
            */
            %persistent string PhysicalReference = "";

            /**
            * Indicates if the WANMode is considered owned by the:
            * * "system": Typically a predefined WANMode which is configured by an ISP for a specific network layout.
            * * "user": Typically a WANMode defined by a HGW user via a webui, or a configuration APP.
            * By default we consider new WANModes owned by a "user".
            * @version 1.0
            */
            %persistent string Origin {
                on action validate call check_enum ["system", "user"];
                default "user";
            }

            /**
            * Indicates if the WANMode is applicable for WANAutoSensing or not.
            * @version 1.0
            */
            %persistent bool EnableSensing {
                default true;
            }

            /**
            * Ignored when EnableSensing is false.
            * This value indicates how important this WANMode is compared to others in the context of autosensing.
            * Highest priority will be the WANMode with the lowest SensingPriority.
            * Multiple WANModes can have the same SensingPriority value, in that case there is no preference on which of those is set.
            * @version 1.0
            */
            %persistent uint32 SensingPriority {
                default 0;
            }

            /**
            * Status parameter to indicate the WAN Mode is active, in error state or disabled
            * @version 1.0
            */
            %persistent %read-only string Status {
                on action validate call check_enum ["Enabled", "Disabled", "Error"];
                default "Disabled";
            }

            /**
            * Parameter that define the way how to configure the DNS servers. Enumeration of:
            * - Static
            * - Dynamic
            * @version 1.0
            */
            %persistent string DNSMode {
                on action validate call check_enum ["Static", "Dynamic", ""];
                default "Dynamic";
                userflags %upc;
            }

            /**
            * Parameter that define the way how to configure the DNS servers. Enumeration of:
            * - Static
            * - Dynamic
            * @version 1.0
            */
            %persistent string IPv6DNSMode {
                on action validate call check_enum ["Static", "Dynamic", ""];
                default "Dynamic";
                userflags %upc;
            }

            /**
            * Indicates the SFP type that is detected.
            * Enumeration of :
            *   XGSPON
            *   GPON
            *   AE
            *   10G-T
            *   Defaults to empty string indicates no SFP inserted
            */
            %persistent %read-only string SFPType {
                default "";
            }

            /**
             * Only SFP types that are added to this comma separated list can be configured
             * in the SFPType parameter.
             * Supported SFPType could be :
             *   XGSPON
             *   GPON
             *   AE
             *   10G-T
             */
            %persistent %protected %read-only string SupportedSFPTypes {
                default "";
            }
        }
    }
}

%populate {
    on event "dm:object-changed" call dm_wan_manager_physical_type_changed
        filter 'path matches "WANManager\.WAN\.[0-9]+\.$" && (
            (contains("parameters.PhysicalType")) ||
            (contains("parameters.PhysicalReference"))
        )';
    on event "dm:object-changed" call wan_sensing_priority_changed
        filter 'path matches "WANManager\.WAN\.[0-9]+\.$" && (
            (contains("parameters.SensingPriority"))
        )';
    on event "dm:object-changed" call update_network_selector
        filter 'path matches "WANManager." and contains("parameters.SFPType")';
    on event "dm:instance-added" call dm_wan_manager_wan_added
        filter 'path matches "WANManager\.WAN\.$"';
}
