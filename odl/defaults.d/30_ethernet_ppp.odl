%populate {
    object 'WANManager.WAN' {
        instance add ("Ethernet_PPP"){
            parameter Alias = "Ethernet_PPP";
            parameter PhysicalType = "Ethernet";
        }
    }

    object 'WANManager.WAN.Ethernet_PPP.Intf'{
        instance add(0,"wan"){
            parameter Type = "vlan";
            parameter IPv4Mode = "ppp4";
            parameter DefaultInterface = true;
            parameter IPv6Mode = "dhcp6";
            parameter Name = "wan";
            parameter VlanID = 100;
            parameter VlanPriority = 0;
            parameter IPv4Reference = "Device.IP.Interface.2.";
            parameter IPv6Reference = "Device.IP.Interface.6.";
            parameter DeferredIPv6Instances = "Device.IP.Interface.3.,Device.IP.Interface.4.,Device.IP.Interface.5.";
        }

        instance add(0,"voip"){
            parameter Type = "vlan";
            parameter IPv4Mode = "dhcp4";
            parameter IPv6Mode = "none";
            parameter Name = "voip";
            parameter VlanID = 101;
            parameter VlanPriority = 0;
            parameter IPv4Reference = "Device.IP.Interface.9.";
            parameter IPv6Reference = "Device.IP.Interface.9.";
        }

        instance add(0,"iptv"){
            parameter Type = "vlan";
            parameter IPv4Mode = "dhcp4";
            parameter IPv6Mode = "none";
            parameter Name = "iptv";
            parameter VlanID = 102;
            parameter VlanPriority = 0;
            parameter IPv4Reference = "Device.IP.Interface.10.";
            parameter IPv6Reference = "Device.IP.Interface.10.";
        }

        instance add(0,"mgmt"){
            parameter Type = "vlan";
            parameter IPv4Mode = "dhcp4";
            parameter IPv6Mode = "none";
            parameter Name = "mgmt";
            parameter VlanID = 103;
            parameter VlanPriority = 0;
            parameter IPv4Reference = "Device.IP.Interface.11.";
            parameter IPv6Reference = "Device.IP.Interface.11.";
        }
    }
}
