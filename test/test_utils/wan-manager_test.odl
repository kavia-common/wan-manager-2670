%config{
    prefix_ = "X_PRPL-COM_";
}
include "../../odl/wan-manager_definition.odl";
include "../../odl/wan-manager_WAN_definition.odl";
include "../../odl/wan-manager_WAN_Intf_definition.odl";

%define{
    object Ethernet {
        object VLANTermination{}
    }

    object Device{
        object Ethernet {
        object Link{}
        }
    }

    object DHCPv4 {
        object Client {}
    }

    object NetDev{
        object Link {}
    }

    object '${prefix_}WANAutoSensing'{}
}

%populate {
    object '${prefix_}WANManager.WAN' {
        instance add (0,""){
           parameter PhysicalType = "SFP";
        }
    }

    object '${prefix_}WANManager.WAN.1.Intf'{
        instance add (0,"wan"){
            parameter Type = "untagged";
            parameter IPv4Mode = "dhcp4";
            parameter IPReference = "IP.Interface.2.";
        }
    }

}
include "../../odl/wan-manager_defaults.odl";
