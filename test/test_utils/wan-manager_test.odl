%config {
    name = "wan-manager";
    import-dbg = false;
}

include "../../odl/${name}_definition.odl";
include "../../odl/${name}_WAN_definition.odl";
include "../../odl/${name}_WAN_Intf_definition.odl";

%define{
    object 'WANAutoSensing'{}
}

%populate {
    object 'WANManager' {
        parameter WANMode = "demo_wanmode";
    }

    object 'WANManager.WAN' {
        instance add ("demo_wanmode"){
           parameter PhysicalType = "Ethernet";
        }
        instance add ("demo_vlanmode"){
           parameter PhysicalType = "Ethernet";
           parameter DNSMode = "Static";
        }
        instance add ("test_mode"){
           parameter PhysicalType = "Ethernet";
        }
        instance add ("demo_pppmode"){
           parameter Alias = "demo_pppmode";
           parameter PhysicalType = "Ethernet";
        }
        instance add ("demo_staticmode"){
            parameter Alias = "demo_staticmode";
            parameter PhysicalType = "Ethernet";
            parameter EnableSensing = false;
        }
        instance add ("demo_ppp6mode"){
            parameter Alias = "demo_ppp6mode";
            parameter PhysicalType = "Ethernet";
            parameter DNSMode = "Dynamic";
        }
        instance add("demo_dslite"){
            parameter Alias = "demo_dslite";
            parameter PhysicalType = "Ethernet";
        }
        instance add ("demo_link"){
            parameter Alias = "demo_link";
            parameter PhysicalType = "Ethernet";
        }
        instance add ("Bridge_mode"){
            parameter Alias = "Bridge_mode";
            parameter PhysicalType = "Ethernet";
            parameter EnableSensing = false;
        }
        instance add ("Bridge_vlanmode"){
            parameter Alias = "Bridge_vlanmode";
            parameter PhysicalType = "Ethernet";
            parameter EnableSensing = false;
        }
    }

    object 'WANManager.WAN.demo_wanmode.Intf'{
        instance add(0,"wan"){
            parameter Name = "wan";
            parameter Type = "untagged";
            parameter IPv4Mode = "dhcp4";
            parameter DefaultRouteReference = "Device.Routing.Router.1.IPv4Forwarding.1.";
            parameter IPv6Mode = "dhcp6";
            parameter IPv4Reference = "Device.IP.Interface.2.";
            parameter IPv6Reference = "Device.IP.Interface.2.";
            parameter DeferredIPv6Instances = "Device.IP.Interface.3.,Device.IP.Interface.4.,Device.IP.Interface.5.";
            parameter DHCPv4Reference = "Device.DHCPv4.Client.1.";
            parameter DHCPv6Reference = "Device.DHCPv6.Client.1.";
        }
    }

    object 'WANManager.WAN.demo_vlanmode.Intf'{
        instance add(0,"wan"){
            parameter Name = "wan";
            parameter Type = "vlan";
            parameter IPv4Mode = "dhcp4";
            parameter DefaultRouteReference = "Device.Routing.Router.1.IPv4Forwarding.1.";
            parameter IPv6Mode = "none";
            parameter VlanID = 201;
            parameter VlanPriority = 0;
            parameter IPv4Reference = "Device.IP.Interface.2.";
            parameter IPv6Reference = "Device.IP.Interface.2.";
            parameter DeferredIPv6Instances = "Device.IP.Interface.3.,Device.IP.Interface.4.,Device.IP.Interface.5.";
            parameter DHCPv4Reference = "Device.DHCPv4.Client.1.";
            parameter DHCPv6Reference = "Device.DHCPv6.Client.1.";
        }
    }

    object 'WANManager.WAN.demo_pppmode.Intf'{
        instance add(0,"wan"){
            parameter Type = "untagged";
            parameter IPv4Mode = "ppp4";
            parameter DefaultRouteReference = "Device.Routing.Router.1.IPv4Forwarding.1.";
            parameter IPv6Mode = "dhcp6";
            parameter UserName = "ppp4";
            parameter Password = "softathome";
            parameter IPv4Reference = "Device.IP.Interface.2.";
            parameter IPv6Reference = "Device.IP.Interface.6.";
            parameter DeferredIPv6Instances = "Device.IP.Interface.3.,Device.IP.Interface.4.,Device.IP.Interface.5.";
            parameter DHCPv4Reference = "Device.DHCPv4.Client.1.";
            parameter DHCPv6Reference = "Device.DHCPv6.Client.1.";
        }
    }

    object 'WANManager.WAN.demo_dslite.Intf'{
        instance add(0,"wan"){
            parameter Type = "untagged";
            parameter IPv4Mode = "dslite";
            parameter DefaultRouteReference = "Device.Routing.Router.1.IPv4Forwarding.1.";
            parameter IPv6Mode = "dhcp6";
            parameter IPv4Reference = "Device.IP.Interface.7.";
            parameter IPv6Reference = "Device.IP.Interface.2.";
            parameter DeferredIPv6Instances = "Device.IP.Interface.3.,Device.IP.Interface.4.,Device.IP.Interface.5.";
            parameter DHCPv4Reference = "Device.DHCPv4.Client.1.";
            parameter DHCPv6Reference = "Device.DHCPv6.Client.1.";
        }
    }

    object 'WANManager.WAN.demo_staticmode.Intf'{
        instance add(0,"wan"){
            parameter Type = "untagged";
            parameter IPv4Mode = "static";
            parameter DefaultRouteReference = "Device.Routing.Router.1.IPv4Forwarding.1.";
            parameter IPv6Mode = "static";
            parameter IPv4Reference = "Device.IP.Interface.2.";
            parameter IPv6Reference = "Device.IP.Interface.2.";
            parameter DeferredIPv6Instances = "Device.IP.Interface.3.,Device.IP.Interface.4.,Device.IP.Interface.5.";
            parameter DHCPv4Reference = "Device.DHCPv4.Client.1.";
            parameter DHCPv6Reference = "Device.DHCPv6.Client.1.";
        }
    }

    object 'WANManager.WAN.demo_ppp6mode.Intf'{
        instance add(0,"wan"){
            parameter Type = "vlan";
            parameter IPv4Mode = "none";
            parameter IPv6Mode = "ppp6";
            parameter UserName = "softathome";
            parameter Password = "ppp6";
            parameter VlanID = 144;
            parameter VlanPriority = 0;
            parameter IPv4Reference = "";
            parameter IPv6Reference = "Device.IP.Interface.2.";
            parameter IPv6AddressDelegate="Device.IP.Interface.3.";
            parameter DeferredIPv6Instances = "Device.IP.Interface.3.,Device.IP.Interface.4.,Device.IP.Interface.5.";
            parameter DHCPv4Reference = "Device.DHCPv4.Client.1.";
            parameter DHCPv6Reference = "Device.DHCPv6.Client.1.";
        }
    }

    object 'WANManager.WAN.demo_link.Intf'{
        instance add(0,"wan"){
            parameter Name = "wan";
            parameter Type = "untagged";
            parameter IPv4Mode = "dhcp4";
            parameter IPv6Mode = "dhcp6";
            parameter IPv4Reference = "Device.IP.Interface.2.";
            parameter IPv6Reference = "Device.IP.Interface.2.";
            parameter DeferredIPv6Instances = "Device.IP.Interface.3.,Device.IP.Interface.4.,Device.IP.Interface.5.";
            parameter DHCPv4Reference = "Device.DHCPv4.Client.1.";
            parameter DHCPv6Reference = "Device.DHCPv6.Client.1.";
        }
        instance add(0,"voip"){
            parameter Name = "voip";
            parameter Type = "untagged";
            parameter IPv4Mode = "link";
            parameter IPv6Mode = "link";
            parameter IPv4Reference = "Device.IP.Interface.2.";
            parameter IPv6Reference = "Device.IP.Interface.2.";
            parameter DeferredIPv6Instances = "";
            parameter DHCPv4Reference = "Device.DHCPv4.Client.2.";
            parameter DHCPv6Reference = "Device.DHCPv6.Client.2.";
        }
        instance add(0,"mgmt"){
            parameter Name = "mgmt";
            parameter Type = "untagged";
            parameter IPv4Mode = "link";
            parameter IPv6Mode = "link";
            parameter IPv4Reference = "Device.IP.Interface.2.";
            parameter IPv6Reference = "Device.IP.Interface.2.";
            parameter DeferredIPv6Instances = "";
            parameter DHCPv4Reference = "Device.DHCPv4.Client.3.";
            parameter DHCPv6Reference = "Device.DHCPv6.Client.3.";
        }
    }

    object 'WANManager.WAN' {
        instance add ("demo_SFP"){
           parameter Alias = "demo_SFP";
           parameter PhysicalType = "SFP";
           object Intf {
                instance add (0,"testwan"){
                    parameter Name = "wan";
                    parameter Type = "untagged";
                    parameter IPv4Mode = "dhcp4";
                    parameter IPv6Mode= "dhcp6";
                    parameter IPv4Reference = "Device.IP.Interface.2.";
                    parameter IPv6Reference = "Device.IP.Interface.2.";
                    parameter DHCPv4Reference = "Device.DHCPv4.Client.1.";
                    parameter DHCPv6Reference = "Device.DHCPv6.Client.1.";
                }
            }
        }
    }

    object 'WANManager.WAN' {
        instance add ("demo_test"){
           parameter Alias = "demo_test";
           parameter PhysicalType = "Ethernet";
           object Intf {
                instance add (0,"testwan"){
                    parameter Name = "wan";
                    parameter Type = "untagged";
                    parameter IPv4Mode = "dhcp4";
                    parameter IPv6Mode= "dhcp6";
                    parameter IPv4Reference = "Device.IP.Interface.2.";
                    parameter IPv6Reference = "Device.IP.Interface.2.";
                    parameter DHCPv4Reference = "Device.DHCPv4.Client.1.";
                    parameter DHCPv6Reference = "Device.DHCPv6.Client.1.";
                }
            }
        }
    }

    object 'WANManager.WAN.test_mode.Intf'{
        instance add(0,"wan"){
            parameter Name = "wan";
            parameter Type = "untagged";
            parameter IPv4Mode = "dhcp4";
            parameter IPv6Mode = "none";
            parameter IPv4Reference = "Device.IP.Interface.2.";
            parameter IPv6Reference = "Device.IP.Interface.2.";
            parameter DeferredIPv6Instances = "Device.IP.Interface.3.,Device.IP.Interface.4.,Device.IP.Interface.5.";
            parameter DHCPv4Reference = "Device.DHCPv4.Client.1.";
            parameter DHCPv6Reference = "Device.DHCPv6.Client.1.";
        }
    }

    object 'WANManager.WAN.demo_dslite.Intf.wan.IPv4Address'{
        instance add("ipv4"){
            parameter DNSServers = "8.8.8.8,1.1.1.1";
            parameter DefaultRouter = "80.16.3.1";
            parameter IPv4Address = "80.16.3.110";
            parameter SubnetMask = "255.255.255.0";
        }
    }

    object 'WANManager.WAN.demo_vlanmode.Intf.wan.IPv4Address'{
        instance add("ipv4"){
            parameter DNSServers = "8.8.8.8,1.1.1.1";
            parameter DefaultRouter = "80.16.3.1";
            parameter IPv4Address = "80.16.3.111";
            parameter SubnetMask = "255.255.255.0";
        }
    }

    object 'WANManager.WAN.demo_vlanmode.Intf.wan.IPv6Address'{
        instance add("ipv6"){
            parameter DNSServers = "2620:119:35::35";
        }
    }

    object 'WANManager.WAN.demo_staticmode.Intf.wan.IPv6Address'{
        instance add("ipv6"){
            parameter DefaultRouter = "fe80::5014:93ff:fe4d:7cf";
            parameter IPv6Address = "2a02:1802:94:3200:10:18ff:fe01:cc01";
        }
    }

    object 'WANManager.WAN.demo_staticmode.Intf.wan.IPv4Address'{
        instance add("ipv4"){
            parameter DNSServers = "8.8.8.8,1.1.1.1";
            parameter DefaultRouter = "80.16.3.1";
            parameter IPv4Address = "80.16.3.112";
            parameter SubnetMask = "255.255.255.0";
        }
    }

    object 'WANManager.WAN.Bridge_mode.Intf'{
        instance add(0,"wan"){
            parameter Type = "untagged";
            parameter IPv4Mode = "none";
            parameter IPv6Mode = "none";
            parameter Name = "wan";
            parameter IPv4Reference = "Device.IP.Interface.2.";
            parameter IPv6Reference = "Device.IP.Interface.2.";
            parameter BridgeReference = "Device.Bridging.Bridge.1.";
            parameter DHCPv4Reference = "Device.DHCPv4.Client.1.";
            parameter DHCPv6Reference = "Device.DHCPv6.Client.1.";
        }
    }

    object 'WANManager.WAN.Bridge_vlanmode.Intf'{
        instance add(0,"wan"){
            parameter Type = "vlan";
            parameter IPv4Mode = "none";
            parameter IPv6Mode = "none";
            parameter Name = "wan";
            parameter VlanID = 100;
            parameter VlanPriority = 3;
            parameter IPv4Reference = "Device.IP.Interface.2.";
            parameter IPv6Reference = "Device.IP.Interface.2.";
            parameter BridgeReference = "Device.Bridging.Bridge.1.";
            parameter DHCPv4Reference = "Device.DHCPv4.Client.1.";
            parameter DHCPv6Reference = "Device.DHCPv6.Client.1.";
        }
    }
}
