%define {
    object IP {
        object Interface[] {

            string Alias;
            bool Enable;
            bool IPv6Enable;
            bool IPv4Enable;
            string LowerLayers;

            object IPv4Address[] {
                string Alias;
                string Status = "Disabled";
                string IPAddress;
                string SubnetMask;
                string AddressingType;
                bool Enable;
            }

            object IPv6Address[]{
                string Alias;
                bool Enable = 1;
                string IPAddress;
                string IPAddressStatus;
                string Origin;
                string Prefix;
                uint32 PrefixLen = 0;
            }

            object IPv6Prefix[]{
                bool Enable = false;
                string Alias;
                string ParentPrefix;
                string Origin;
                string Prefix;
                string ChildPrefixBits;
                string ValidLifetime;
                string PreferredLifetime;
                string StaticType;
                bool Autonomous;
                bool OnLink;
            }

            string IPv6AddressDelegate;
        }
    }
}

%populate {
    object IP.Interface {
        instance add(2, "wan") {
            object IPv4Address {
                instance add(0,"primary") {
                    parameter Alias = "primary";
                    parameter AddressingType = "DHCP";
                }
            }

            object IPv6Address {
                instance add(0,"GUA_RA"){
                    parameter Alias = "GUA_RA";
                    parameter Enable = 1;
                }
                instance add(2,"GUA_STATIC"){
                    parameter Alias = "GUA_STATIC";
                    parameter Enable = 1;
                    parameter Origin = "Static";
                }
            }

            object IPv6Prefix {
                instance add(0,"GUA_IAPD"){
                    parameter Alias = "GUA_IAPD";
                    parameter Enable = 1;
                }
                instance add(2,"GUA_STATIC"){
                    parameter Alias = "GUA_STATIC";
                    parameter Enable = 1;
                    parameter Origin = "Static";
                }
            }
        }
    }

    object IP.Interface {
        instance add(3, "lan") {
            parameter Alias = "lan";
            object IPv4Address {
                instance add(0,"primary") {
                    parameter Alias = "primary";
                    parameter AddressingType = "DHCP";
                }
            }

            object IPv6Address {
                instance add(0,"GUA_RA"){
                    parameter Alias = "GUA_RA";
                    parameter Enable = 1;
                }
            }

            object IPv6Prefix {
                instance add(0,"GUA_IAPD"){
                    parameter Alias = "GUA_IAPD";
                    parameter Enable = 1;
                    parameter ParentPrefix = "Device.IP.Interface.2.IPv6Prefix.1.";
                }
                instance add("GUA_STATIC"){
                    parameter Alias = "GUA_STATIC";
                    parameter Origin = "Static";
                    parameter StaticType = "Static";
                }
            }
        }
    }

    object IP.Interface {
        instance add(4, "guest") {
            object IPv4Address {
                instance add(0,"primary") {
                    parameter Alias = "primary";
                    parameter AddressingType = "DHCP";
                }
            }

            object IPv6Address {
                instance add(0,"GUA_RA"){
                    parameter Alias = "GUA_RA";
                    parameter Enable = 1;
                }
            }

            object IPv6Prefix {
                instance add(0,"GUA_IAPD"){
                    parameter Alias = "GUA_IAPD";
                    parameter Enable = 1;
                    parameter ParentPrefix = "Device.IP.Interface.2.IPv6Prefix.1.";
                }
            }
        }
    }

    object IP.Interface {
        instance add(5, "lcm") {
            object IPv4Address {
                instance add(0,"primary") {
                    parameter Alias = "primary";
                    parameter AddressingType = "DHCP";
                }
            }

            object IPv6Address {
                instance add(0,"GUA_RA"){
                    parameter Alias = "GUA_RA";
                    parameter Enable = 1;
                }
            }

            object IPv6Prefix {
                instance add(0,"GUA_IAPD"){
                    parameter Alias = "GUA_IAPD";
                    parameter Enable = 1;
                    parameter ParentPrefix = "Device.IP.Interface.2.IPv6Prefix.1.";
                }
            }
        }
    }

    object IP.Interface {
        instance add(6, "wan6") {
            object IPv4Address {
                instance add(0,"wan6") {
                    parameter AddressingType = "DHCP";
                }
            }

            object IPv6Prefix {
                instance add(0,"GUA_IAPD"){
                    parameter Alias = "GUA_IAPD";
                    parameter Enable = 1;
                    parameter ParentPrefix = "Device.IP.Interface.2.IPv6Prefix.1.";
                }
            }
        }
    }
}
