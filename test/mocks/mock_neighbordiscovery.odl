%define {
    select Device {
        object NeighborDiscovery {
            object InterfaceSetting[] {

                bool AcceptDefaultRoute;
                string Alias;
                bool AutoConfEnable;
                uint32 DADTransmits;
                bool Enable;
                string Interface;
                uint32 MaxRtrSolicitations;
                bool NUDEnable;
                bool RSEnable;
                uint32 RetransTimer;
                uint32 RtrSolicitationInterval;
                string Status;
            }
        }
    }
}

%populate {
    object Device.NeighborDiscovery.InterfaceSetting {
        instance add(1, "cpe-wan") {
            parameter AcceptDefaultRoute = true;
            parameter Alias = "cpe-wan";
            parameter AutoConfEnable = true;
            parameter DADTransmits = 1;
            parameter Enable = true;
            parameter Interface ="Device.Logical.Interface.1.";
            parameter MaxRtrSolicitations = 3;
            parameter NUDEnable = true;
            parameter RSEnable = true;
            parameter RetransTimer = 1000;
            parameter RtrSolicitationInterval = 4000;
            parameter Status = "Enabled";
        }
    }
}
