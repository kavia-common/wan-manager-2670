%config{
    prefix_ = "X_PRPL-COM_";
}
include "../../odl/wan-manager_definition.odl";
include "../../odl/wan-manager_WAN_definition.odl";
include "../../odl/wan-manager_WAN_Intf_definition.odl";

%define{
    object Ethernet {
        object VLANTermination{}
    }

    object Device{
        object Ethernet {
        object Link{}
        }
    }

    object DHCPv4 {
        object Client {}
    }

        object IP{
            object Interface {}
        }

    object NetDev{
        object Link {}
    }

    object '${prefix_}WANAutoSensing'{}
}
%populate {
    object '${prefix_}WANManager.WAN' {
        instance add ("demo_SFP"){
           parameter Alias = "demo_SFP";
           parameter PhysicalType = "SFP";
           object Intf { 
                instance add (0,"testwan"){
                    parameter Type = "untagged";
                    parameter IPv4Mode = "dhcp4";
                    parameter IPReference = "Device.IP.Interface.2.";
                }
            }
        }
    }
}

include "../../odl/wan-manager_defaults.odl";

%populate {
    object '${prefix_}WANManager.WAN' {
        instance add ("demo_test"){
           parameter Alias = "demo_test";
           parameter PhysicalType = "Ethernet";
           object Intf { 
                instance add (0,"testwan"){
                    parameter Type = "untagged";
                    parameter IPv4Mode = "dhcp4";
                    parameter IPReference = "Device.IP.Interface.2.";
                }
            }
        }
    }
}
