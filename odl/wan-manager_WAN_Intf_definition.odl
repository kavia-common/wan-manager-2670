%define {
    select 'WANManager.WAN' {
        /**
         *
         * WAN mode definition
         * @version 1.0
         */
        %persistent object Intf[4] {
            on action destroy call interface_destroy;

            /**
            * A non-volatile unique key used to reference this instance (as defined in TR181)
            * @version 1.0
            */
            %persistent %unique %key string Alias {
                on action validate call check_maximum_length 64;
            }

            /**
            * The textual name of interface (one of wan, voip, mgmt, iptv)
            * @version 1.0
            */
            %persistent string Name {
                on action validate call check_enum ["wan", "voip", "mgmt", "iptv"];
                on action validate call interface_already_configured;
                default "wan";
            }

            /**
            * PPP User name
            * Takes precedence over username filled in tr181-ppp plugin, except when it is empty.
            * @version 1.0
            */
            %persistent string UserName{
                on action validate call check_maximum_length 64;
            }

            /**
            * PPP User password
            * Takes precedence over password filled in tr181-ppp plugin, except when it is empty.
            * @version 1.0
            */
            %persistent string Password {
                on action validate call check_maximum_length 64;
            }

            /**
            * Interface IPv4 configured mode:
            * - none: No IPv4 address at all on this interface
            * - link: Instead of having your own IPv4 address, use the address set for the IPv4Reference interface.
            * @version 1.0
            */
            %persistent string IPv4Mode{
                on action validate call check_enum ["dhcp4", "ppp4", "none", "static", "dslite", "link"];
                default "dhcp4";
            }

            /**
            * Interface IPv6 configured mode:
            * - none: No IPv6 address at all on this interface
            * - link: Instead of having your own IPv6 address, use the address set for the IPv6Reference interface.
            * @version 1.0
            */
            %persistent string IPv6Mode{
                on action validate call check_enum ["dhcp6", "ppp6", "none", "static", "link"];
                default "none";
            }

            /**
            * Mapped Lower layer interface for IPv4
            * @version 1.0
            */
            %persistent string IPv4Reference{
                default "";
            }

            /**
            * Indicates if the interface should be used as the default or not.
            * A default route will be created for the default interface.
            * Every wan-mode can only have one default interface.
            * @version 1.0
            */
            %persistent bool DefaultInterface = false {
                on action validate call mode_check_default_interface;
            }

            /**
            * Mapped Lower layer interface for IPv6
            * @version 1.0
            */
            %persistent string IPv6Reference{
                default "";
            }

            /**
            * High level interface Type, one of "untagged", "vlan", "atm"
            * @version 1.0
            */
            %persistent string Type{
                on action validate call check_enum ["untagged", "vlan", "atm"];
                default "untagged";
            }

            /**
            * Vlan ID, number between 0 and 4096
            * @version 1.0
            */
            %persistent uint32 VlanID{
                default 100;
            }

            /**
            * Vlan priority, number between -1 and 7
            * -1 - priority not assigned
            * @version 1.0
            */
            %persistent int32 VlanPriority{
                on action validate call check_range { min = -1, max = 7};
                default 0;
            }

            /**
            * comma separated list of IP instances (typically lan interfaces)
            * WAN-manager will manage the ParentPrefixes for the IPv6Prefixes in these interfaces
            * @version 1.0
            */
            %persistent csv_string DeferredIPv6Instances;

            /**
            * Reference to the bridge, if filled in the bridge mode will be enabled
            * @version 1.0
            */
            %persistent string BridgeReference{
                default "";
            }

            /**
            * Static IPv4 network configuration
            * Only applicable if Mode4 is set to static
            * Only one instance is expected per wan_mode
            * @version 1.0
            */
            %persistent object IPv4Address[1]{

                /**
                * Static IPv4 Address
                * @version 1.0
                */
                %persistent string IPv4Address{
                    on action validate call check_maximum_length 15;
                }

                /**
                * Static IPv4 Subnetmask
                * @version 1.0
                */
                %persistent string SubnetMask{
                    on action validate call check_maximum_length 15;
                }

                /**
                * Static IPv4 default router address
                * @version 1.0
                */
                %persistent string DefaultRouter{
                    on action validate call check_maximum_length 15;
                }

                /**
                * comma separated list of static IPv4 DNS Server addresses.
                * at most 4 ipv4 addresses can be provided.
                * @version 1.0
                */
                %persistent csv_string DNSServers{
                    on action validate call check_maximum_length 64;
                }
            }

            /**
            * Static IPv6 network configuration
            * Only applicable if Mode6 is set to static
            * Only one instance is expected per wan_mode
            * @version 1.0
            */
            %persistent object IPv6Address[1]{

                /**
                * Static IPv6 Address
                * @version 1.0
                */
                %persistent string IPv6Address{
                    on action validate call check_maximum_length 45;
                }

                /**
                * Static IPv6 PrefixLength, typically a number between 0 and 128
                * @version 1.0
                */
                %persistent uint32 PrefixLength = 64;

                /**
                * Static IPv6 default router address
                * @version 1.0
                */
                %persistent string DefaultRouter{
                    on action validate call check_maximum_length 45;
                }

                /**
                * comma separated list of static IPv6 DNS Server addresses.
                * at most 4 ipv6 addresses can be provided.
                * @version 1.0
                */
                %persistent csv_string DNSServers{
                    on action validate call check_maximum_length 180;
                }
            }

            /**
            * If set the wan-manager will threat this interface as unnumbered.
            * Contains the Device path to the LAN interface where the IPv6 address should be taken from.
            * Currently only used for PPP modes.
            *
            * @version 1.0
            */
            %persistent string IPv6AddressDelegate{
                on action validate call check_maximum_length 1024;
                on action validate call matches_regexp "^Device\.IP\.Interface\.[0-9]+\.$";
            }
        }
    }
}

%populate {
    on event "dm:object-changed" call wan_sensing_toggled
        filter 'path matches "WANManager\.WAN\.[0-9]+\.$" and contains("parameters.EnableSensing")';
    on event "dm:object-changed" call ipv4_mode_toggled
        filter 'path matches "WANManager\.WAN\.[0-9]+\.Intf\.[0-9]+\.$" and contains("parameters.IPv4Mode")';
    on event "dm:object-changed" call ipv6_mode_toggled
        filter 'path matches "WANManager\.WAN\.[0-9]+\.Intf\.[0-9]+\.$" and contains("parameters.IPv6Mode")';
}