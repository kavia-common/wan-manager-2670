%define {
    select '${prefix_}WANManager' {
        /**
         * WAN mode definition
         * @version 1.0
         */
        %persistent object WAN[] {
            /**
            * A non-volatile unique key used to reference this instance (as defined in TR181)
            * @version 1.0
            */
            %persistent %unique %key string Alias {
                on action validate call check_maximum_length 64;
            }

            /**
            * Physical interface type of the WAN mode.
            * @version 1.0
            */
            %persistent string PhysicalType  {
                constraint enum ["Ethernet", "ADSL", "VDSL", "SFP", "GPON", "GFAST", "Bridge", "WWAN"];
                default "Ethernet";
            }

            /**
            * Status parameter to indicate the WAN Mode is active, in error state or disabled
            * @version 1.0
            */
            %read-only string Status {
                constraint enum ["Enabled", "Disabled", "Error"];
                default "Disabled";
            }

           /**
            * Mechanism via which the wanmode was assigned. Enumeration of:
            * - system
            * - user
            *
            * @version 1.0
            */
            %persistent %read-only string Origin {
                constraint enum ["system","user"];
                default "user";
            }

            /**
            * Parameter that define the way how to configure the DNS servers. Enumeration of:
            * - DHCPv4
            * - DHCPv6
            * - RouterAdvertisement
            * - IPCP
            * - Static
            * - Dynamic
            *   
            * @version 1.0
            */
            %persistent string DNSMode {
                constraint enum ["DHCPv4", "DHCPv6", "RouterAdvertisement", "IPCP", "Static", "Dynamic", ""];
                default "Dynamic";
            }
        }
    }
}

%populate {
    on event "dm:object-changed" call dm_wan_manager_physical_type_changed
        filter 'path matches "${prefix_}WANManager." and contains("parameters.PhysicalType")';
    on event "dm:instance-added" call dm_wan_manager_wan_added
        filter 'path matches "${prefix_}WANManager\.WAN\.$"';

    on event "*" call print_event;
}