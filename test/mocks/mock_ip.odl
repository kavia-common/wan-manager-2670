%define {
    select Device {
        object IP {
            object Interface[] {

                bool Enable;
                bool IPv6Enable;
                bool IPv4Enable;
                string LowerLayers;

                object IPv4Address[] {
                    string Alias;
                    string Status = "Disabled";
                    string IPAddress;
                    string SubnetMask;
                    string AddressingType;
                    bool Enable;
                }

                object IPv6Address[]{
                    string Alias;
                    bool Enable = 1;
                    string IPAddress;
                    string IPAddressStatus;
                    string Origin;
                }

                string IPv6AddressDelegate;
            }
        }
    }
}

%populate {
    object Device.IP.Interface {
        instance add(2, "wan") {
            object IPv4Address {
                instance add(0,"primary") {
                    parameter Alias = "primary";
                    parameter AddressingType = "DHCP";
                }
            }

            object IPv6Address {
                instance add(0,"GUA_RA"){
                    parameter Alias = "GUA_RA";
                    parameter Enable = 1;
                }
            }
        }
    }

    object Device.IP.Interface {
        instance add(3, "lan") {
            object IPv4Address {
                instance add(0,"primary") {
                    parameter Alias = "primary";
                    parameter AddressingType = "DHCP";
                }
            }

            object IPv6Address {
                instance add(0,"GUA_RA"){
                    parameter Alias = "GUA_RA";
                    parameter Enable = 1;
                }
            }
        }
    }

    object Device.IP.Interface {
        instance add(6, "wan6") {
            object IPv4Address {
                instance add(0,"wan6") {
                    parameter AddressingType = "DHCP";
                }
            }
        }
    }
}
